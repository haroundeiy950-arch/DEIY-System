# ---------------------------------------------------------------- application
DEIY_ENV=development
DEIY_DEBUG=true
DEIY_SECRET_KEY=replace-with-a-long-random-secret
DEIY_PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------------ persistence
DEIY_DATABASE_URL=sqlite:///./deiy.db
# Postgres example:
# DEIY_DATABASE_URL=postgresql+psycopg://deiy:deiy@localhost:5432/deiy

# ---------------------------------------------------------------- storage
DEIY_STORAGE_BACKEND=local
DEIY_STORAGE_ROOT=./var/storage
# Cloudflare R2 / AWS S3
DEIY_S3_BUCKET=
DEIY_S3_ENDPOINT_URL=
DEIY_S3_REGION=auto
DEIY_S3_ACCESS_KEY=
DEIY_S3_SECRET_KEY=

# ------------------------------------------------------------------- tokens
DEIY_ACCESS_TOKEN_TTL=43200
DEIY_ACTIVATION_TOKEN_TTL=259200
DEIY_OTP_TTL=600
DEIY_OTP_MAX_ATTEMPTS=5
DEIY_WATERMARK_TTL=900
DEIY_MEDIA_URL_TTL=3600
# Development only: return OTP/link in the registration response.
DEIY_EXPOSE_DEV_CODES=true

# ------------------------------------------------------------------- policy
DEIY_MINIMUM_AGE=13
DEIY_ROOM_MIN_CAPACITY=10
DEIY_ROOM_MAX_CAPACITY=15
DEIY_ROOM_MAX_DURATION_MINUTES=45
DEIY_SUMMARY_SLA_MINUTES=10
DEIY_DEFAULT_EXAM_DURATION_MINUTES=60
DEIY_AUTO_SUBMIT_ON_EXPIRY=true
DEIY_REQUIRE_CAMERA_FOR_EXAM=true

# --------------------------------------------------------------- AI providers
# mock = offline deterministic fallbacks (default)
# gemini = Google Gemini text tasks; whisper = OpenAI speech-to-text
DEIY_AI_PROVIDER=mock
DEIY_AI_TRANSCRIBER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
DEIY_WHISPER_MODEL=whisper-1
DEIY_GEMINI_MODEL=gemini-1.5-flash
DEIY_AI_TIMEOUT=30
DEIY_AI_AUDIO_COST_PER_MINUTE=0.006
DEIY_AI_TOKEN_COST_PER_1K=0.0005

# --------------------------------------------------------------------- mail
DEIY_MAIL_BACKEND=outbox
DEIY_MAIL_FROM=no-reply@deiy.example
DEIY_SMTP_HOST=
DEIY_SMTP_PORT=587
DEIY_SMTP_USERNAME=
DEIY_SMTP_PASSWORD=
DEIY_SMTP_TLS=true

# ------------------------------------------------------- background workers
DEIY_JOB_WORKER=true
DEIY_JOB_POLL_INTERVAL=0.5
DEIY_JOB_MAX_ATTEMPTS=3

# --------------------------------------------------------------------- CORS
DEIY_CORS_ORIGINS=*
